# ── AI API KEYS ───────────────────────────────────────────────────────────
# API key for OpenRouter Chat models (e.g. gpt-4o-mini)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# API key for OpenAI embedding models (e.g. text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key-here

# ── DATABASE & VECTOR STORE ────────────────────────────────────────────────
# Qdrant host (defaults to 'localhost' for local dev, or 'qdrant' in Docker Compose)
QDRANT_HOST=localhost

# ── BACKEND SECURITY ──────────────────────────────────────────────────────
# Cryptographically secure 256-bit hex JWT signing secret (REQUIRED - no default).
# Generate a random hex string: openssl rand -hex 32
JWT_SECRET=

# Default user password (REQUIRED - no default).
# Generate a secure password and set this.
DEFAULT_USER_PASSWORD=

# Local user password for silent auth (REQUIRED - no default).
LOCAL_USER_PASSWORD=

# ── FRONTEND SILENT AUTH ───────────────────────────────────────────────────
# Credentials for automatic background authentication (optional).
# Set these to enable silent login on page load.
VITE_SILENT_AUTH_USER=local-user
VITE_SILENT_AUTH_PASS=local123

# ── PROFILE ENVIRONMENT ────────────────────────────────────────────────────
# Active profile. Use 'local' to run with Ollama local inference (phi3:mini / nomic-embed).
# Leave blank or use 'default' to run with cloud-based OpenAI / OpenRouter models.
SPRING_PROFILES_ACTIVE=local
